  "runner": "import hashlib\nimport json\nimport os\nimport platform\nimport shutil\nimport subprocess\nimport time\nimport uuid\nfrom dataclasses import asdict\nfrom pathlib import Path\n\nfrom comparison_tools.build import ProviderBuilds\nfrom comparison_tools.run import Case, execute\nfrom comparison_tools.results import validate\n\nroot = Path('/root/logyard')\nrevision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()\nchanges = subprocess.check_output(['git', 'status', '--porcelain'], cwd=root, text=True).strip()\nif changes:\n    raise SystemExit('candidate workload requires a clean checkout')\nrun = root / 'target/benchmark-virtual' / (time.strftime('%Y%m%d-%H%M%S', time.gmtime()) + '-' + uuid.uuid4().hex[:8])\nrun.mkdir(parents=True)\nshutil.copyfile(__file__, run / 'runner.py')\njava = '/tmp/logyard-tools/jdk/bin/java'\ncases = [\n    Case('warmed-virtual', events=200_000, producers=64, arguments=2, fields=4, format='native-json',\n         rate=20_000, virtual=True, policy='default'),\n    Case('fresh-virtual', events=200_000, producers=64, arguments=2, fields=4, format='native-json',\n         rate=20_000, virtual_per_request=True, policy='default'),\n]\nsources = {}\nfor directory in [root / 'benchmarks/comparison', root / 'scripts/comparison_tools']:\n    for path in sorted(directory.rglob('*')):\n        if path.is_file() and '__pycache__' not in path.parts:\n            sources[str(path.relative_to(root))] = hashlib.sha256(path.read_bytes()).hexdigest()\nenvironment = {\n    'revision': revision, 'working_tree_changes': [], 'platform': platform.platform(),\n    'cpu': subprocess.check_output(['lscpu'], text=True),\n    'java': subprocess.run([java, '-version'], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT).stdout,\n    'sources_sha256': sources, 'runner_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    'forks_per_mode': 3, 'warmup_calls_per_fork': 12_800, 'cases': [asdict(case) for case in cases],\n}\n(run / 'environment.json').write_text(json.dumps(environment, indent=2) + '\\n')\nprint('Candidate:', revision, 'evidence:', run, flush=True)\nwith ProviderBuilds(root, run, root / 'target/benchmark-compare/cache') as builds:\n    provider = builds.build('logyard')\n(run / 'artifacts.json').write_text(json.dumps(provider.artifacts, indent=2) + '\\n')\nresults = []\nfor repetition in range(3):\n    iteration = run / f'iteration-{repetition + 1}'\n    iteration.mkdir()\n    ordered = cases if repetition % 2 == 0 else list(reversed(cases))\n    for case in ordered:\n        result = execute(provider, case, iteration, java, 0)\n        records = validate(result, iteration / result['output'], case.format, case.fields)\n        result['iteration'] = repetition + 1\n        results.append(result)\n        (run / 'results.json').write_text(json.dumps(results, indent=2) + '\\n')\n        print(f'PASS fork {repetition + 1} {case.name}: {len(records)} unique records, '\n              f'dropped INFO {result[\"unwritten_info\"]}, ERROR {result[\"unwritten_error\"]}, '\n              f'caller p99 {result[\"caller_p99_ns\"]} ns, '\n              f'arrival-to-write p99 {result[\"arrival_to_write_p99_ns\"]} ns', flush=True)\nif subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip() != revision:\n    raise AssertionError('candidate changed during qualification')\n(run / 'qualification.json').write_text(json.dumps({'revision': revision, 'status': 'passed',\n    'scope': 'scheduled native JSON delivery with default policies and warmed or fresh virtual callers',\n    'forks': len(results), 'attempted': sum(r['attempted'] for r in results),\n    'written': sum(r['sink_written'] for r in results),\n    'unwritten_info': sum(r['unwritten_info'] for r in results),\n    'unwritten_error': sum(r['unwritten_error'] for r in results)}, indent=2) + '\\n')\nprint('Passed:', run, flush=True)\n"
