#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

python3 - <<'PY'
from __future__ import annotations

import re
import sys
import tomllib
from pathlib import Path

ROOT = Path.cwd()
with (ROOT / "framework-versions.toml").open("rb") as source:
    FRAMEWORK_VERSIONS = tomllib.load(source)["frameworks"]
PREFIX = "com.zsumz.logyard."
MAX_NEW_PRODUCTION_LINES = 240
MAX_GRANDFATHERED_PRODUCTION_LINES = 300
MAX_TEST_OR_EXAMPLE_LINES = 300
SIZE_BASELINE = ROOT / "scripts/java-size-baseline.tsv"
SOURCE_ROOTS = sorted(
    {
        path
        for group in ("modules", "tests", "benchmarks")
        for path in (ROOT / group).glob("*/src/main/java")
        if path.is_dir()
    } | {
        path
        for path in (ROOT / "extensions").glob("**/src/main/java")
        if path.is_dir()
    }
)
TEST_ROOTS = sorted(
    {
        path
        for group in ("modules", "tests", "benchmarks")
        for path in (ROOT / group).glob("*/src/test/java")
        if path.is_dir()
    } | {
        path
        for path in (ROOT / "extensions").glob("**/src/test/java")
        if path.is_dir()
    }
)
EXAMPLE_JAVA_SOURCES = sorted(
    path
    for path in (ROOT / "examples").glob("**/*.java")
    if path.is_file() and "target" not in path.relative_to(ROOT / "examples").parts
)

size_baseline: dict[str, int] = {}
for baseline_line_number, baseline_line in enumerate(SIZE_BASELINE.read_text(encoding="utf-8").splitlines(), start=1):
    if not baseline_line or baseline_line.startswith("#"):
        continue
    fields = baseline_line.split("\t")
    if len(fields) != 2 or not fields[1].isdigit():
        raise SystemExit(f"{SIZE_BASELINE.relative_to(ROOT)}:{baseline_line_number}: expected path<TAB>line-count")
    baseline_source, baseline_limit_text = fields
    baseline_limit = int(baseline_limit_text)
    if baseline_source in size_baseline:
        raise SystemExit(f"{SIZE_BASELINE.relative_to(ROOT)}:{baseline_line_number}: duplicate {baseline_source}")
    if not 220 < baseline_limit <= MAX_GRANDFATHERED_PRODUCTION_LINES:
        raise SystemExit(
            f"{SIZE_BASELINE.relative_to(ROOT)}:{baseline_line_number}: baseline must be between 221 and "
            f"{MAX_GRANDFATHERED_PRODUCTION_LINES} lines"
        )
    size_baseline[baseline_source] = baseline_limit

PACKAGE = re.compile(r"(?m)^package\s+([A-Za-z_][\w.]*)\s*;")
IMPORT = re.compile(r"(?m)^import\s+(?:static\s+)?([A-Za-z_][\w.*]*)\s*;")
UNBOUNDED = (
    (re.compile(r"Executors\.newCachedThreadPool\s*\("), "cached thread pools"),
    (re.compile(r"new\s+LinkedBlocking(?:Queue|Deque)(?:<[^>]*>)?\s*\(\s*\)"),
     "unbounded blocking queues"),
    (re.compile(r"CompletableFuture\.(?:run|supply)Async\s*\([^,)]*\)"),
     "implicit common-pool work"),
)

ALLOWED_IMPORT_PREFIXES = {
    "logyard-api": ("java.", PREFIX + "api."),
    "logyard-core": ("java.", PREFIX + "api.", PREFIX + "core."),
    "logyard-config-toml": ("java.", PREFIX + "api.", PREFIX + "config."),
    "logyard-output-console": (
        "java.", PREFIX + "api.", PREFIX + "output.console."
    ),
    "logyard-output-json": (
        "java.", PREFIX + "api.", PREFIX + "output.json."
    ),
    "logyard-runtime": (
        "java.", PREFIX + "api.", PREFIX + "config.", PREFIX + "core.",
        PREFIX + "output.console.", PREFIX + "output.json.", PREFIX + "runtime."
    ),
    "logyard-slf4j2": (
        "java.", "org.slf4j.", PREFIX + "api.", PREFIX + "runtime.",
        PREFIX + "slf4j."
    ),
    "logyard-spring-boot": (
        "java.", "org.springframework.", PREFIX + "api.", PREFIX + "jul.",
        PREFIX + "runtime.", PREFIX + "spring.boot."
    ),
    "logyard-spring-boot-starter": (
        "java.", PREFIX + "api.", PREFIX + "spring.boot.starter."
    ),
    "logyard-jul": (
        "java.", PREFIX + "api.", PREFIX + "runtime.", PREFIX + "jul."
    ),
    "logyard-system-logger": (
        "java.", PREFIX + "api.", PREFIX + "runtime.", PREFIX + "systemlogger."
    ),
    "logyard-integration-tests": (
        "java.", PREFIX + "api.", PREFIX + "config.", PREFIX + "core.",
        PREFIX + "output.console.", PREFIX + "output.json.", PREFIX + "runtime.",
        PREFIX + "tests."
    ),
    "logyard-benchmarks": (
        "java.", "org.openjdk.jmh.", "org.slf4j.", PREFIX + "api.",
        PREFIX + "core.", PREFIX + "output.console.", PREFIX + "output.json.",
        PREFIX + "runtime.", PREFIX + "slf4j.", PREFIX + "benchmarks."
    ),
    "runtime": (
        "java.", "io.quarkus.", "io.smallrye.config.", "jakarta.inject.", "org.eclipse.microprofile.health.",
        "org.jboss.logmanager.", PREFIX + "api.", PREFIX + "quarkus.", PREFIX + "runtime."
    ),
    "deployment": (
        "java.", "io.quarkus.", PREFIX + "quarkus."
    ),
    "benchmarks": (
        "java.", "org.jboss.logmanager.", "org.openjdk.jmh.", PREFIX + "api.",
        PREFIX + "core.", PREFIX + "quarkus."
    ),
}

EXPECTED_DEPENDENCIES = {
    "modules/logyard-api": set(),
    "modules/logyard-core": {"com.zsumz.logyard:logyard-api"},
    "modules/logyard-config-toml": {"com.zsumz.logyard:logyard-api"},
    "modules/logyard-output-console": {"com.zsumz.logyard:logyard-api"},
    "modules/logyard-output-json": {"com.zsumz.logyard:logyard-api"},
    "modules/logyard-runtime": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-core",
        "com.zsumz.logyard:logyard-config-toml",
        "com.zsumz.logyard:logyard-output-console",
        "com.zsumz.logyard:logyard-output-json",
    },
    "modules/logyard-slf4j2": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-runtime",
        "org.slf4j:slf4j-api",
    },
    "modules/logyard-spring-boot": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-jul",
        "com.zsumz.logyard:logyard-runtime",
        "org.springframework.boot:spring-boot",
        "org.springframework.boot:spring-boot-autoconfigure",
    },
    "modules/logyard-spring-boot-starter": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-slf4j2",
        "com.zsumz.logyard:logyard-spring-boot",
        "org.springframework.boot:spring-boot-starter",
    },
    "modules/logyard-jul": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-runtime",
    },
    "modules/logyard-system-logger": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-runtime",
    },
    "tests/logyard-integration-tests": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-core",
        "com.zsumz.logyard:logyard-config-toml",
        "com.zsumz.logyard:logyard-output-console",
        "com.zsumz.logyard:logyard-output-json",
        "com.zsumz.logyard:logyard-runtime",
    },
    "benchmarks/logyard-benchmarks": {
        "com.zsumz.logyard:logyard-api",
        "com.zsumz.logyard:logyard-core",
        "com.zsumz.logyard:logyard-output-console",
        "com.zsumz.logyard:logyard-output-json",
        "com.zsumz.logyard:logyard-runtime",
        "com.zsumz.logyard:logyard-slf4j2",
        "org.openjdk.jmh:jmh-core",
        "org.slf4j:slf4j-api",
    },
}

ARTIFACT_CONTRACTS = {
    "modules/logyard-api": (
        "com.zsumz.logyard.api",
        {
            "com.zsumz.logyard.api",
            "com.zsumz.logyard.api.annotation",
            "com.zsumz.logyard.api.delivery",
            "com.zsumz.logyard.api.diagnostics",
            "com.zsumz.logyard.api.event",
            "com.zsumz.logyard.api.failure",
            "com.zsumz.logyard.api.format",
            "com.zsumz.logyard.api.ingress",
            "com.zsumz.logyard.api.reload",
            "com.zsumz.logyard.api.spi",
            "com.zsumz.logyard.api.spi.config",
            "com.zsumz.logyard.api.spi.context",
            "com.zsumz.logyard.api.spi.diagnostics",
            "com.zsumz.logyard.api.spi.encoding",
            "com.zsumz.logyard.api.spi.formatting",
            "com.zsumz.logyard.api.spi.output",
            "com.zsumz.logyard.api.spi.processing",
        },
    ),
    "modules/logyard-core": ("com.zsumz.logyard.core", set()),
    "modules/logyard-config-toml": ("com.zsumz.logyard.config.toml", set()),
    "modules/logyard-output-console": ("com.zsumz.logyard.output.console", set()),
    "modules/logyard-output-json": ("com.zsumz.logyard.output.json", set()),
    "modules/logyard-runtime": (
        "com.zsumz.logyard.runtime",
        {
            "com.zsumz.logyard.runtime.bootstrap",
            "com.zsumz.logyard.runtime.management",
        },
    ),
    "modules/logyard-slf4j2": ("com.zsumz.logyard.slf4j2", set()),
    "modules/logyard-spring-boot": (
        "com.zsumz.logyard.spring.boot",
        {
            "com.zsumz.logyard.spring.boot.autoconfigure",
            "com.zsumz.logyard.spring.boot.logging",
            "com.zsumz.logyard.spring.boot.nativeimage",
        },
    ),
    "modules/logyard-spring-boot-starter": (
        "com.zsumz.logyard.spring.boot.starter",
        set(),
    ),
    "modules/logyard-jul": (
        "com.zsumz.logyard.jul",
        {"com.zsumz.logyard.jul"},
    ),
    "modules/logyard-system-logger": ("com.zsumz.logyard.system.logger", set()),
}

errors: list[str] = []
main_files: list[tuple[Path, str]] = []
package_names: set[str] = set()
java_sources: set[str] = set()

for source_root in SOURCE_ROOTS:
    member = source_root.parents[2].name
    allowed = ALLOWED_IMPORT_PREFIXES.get(member)
    if allowed is None:
        errors.append(f"{source_root.relative_to(ROOT)}: no import boundary is defined")
        continue
    for source in sorted(source_root.rglob("*.java")):
        java_sources.add(source.relative_to(ROOT).as_posix())
        if source.name == "module-info.java":
            continue
        relative = source.relative_to(source_root)
        expected_package = ".".join(relative.parent.parts)
        text = source.read_text(encoding="utf-8")
        match = PACKAGE.search(text)
        if match is None:
            errors.append(f"{source.relative_to(ROOT)}: missing package declaration")
            continue
        actual_package = match.group(1)
        if actual_package != expected_package:
            errors.append(
                f"{source.relative_to(ROOT)}: package {actual_package!r} does not match "
                f"source path {expected_package!r}"
            )
        package_names.add(actual_package)
        main_files.append((source, member))

        for imported in IMPORT.findall(text):
            if imported.endswith(".*"):
                errors.append(f"{source.relative_to(ROOT)}: wildcard imports are forbidden")
            if not imported.startswith(allowed):
                errors.append(
                    f"{source.relative_to(ROOT)}: import {imported!r} violates the "
                    f"{member} dependency boundary"
                )

        if "printStackTrace(" in text:
            errors.append(f"{source.relative_to(ROOT)}: printStackTrace is forbidden")
        for pattern, description in UNBOUNDED:
            if pattern.search(text):
                errors.append(f"{source.relative_to(ROOT)}: {description} are forbidden")

        forbidden_integrations = (
            "com.zsumz.logyard.output.otlp",
            "io.opentelemetry.",
            "org.apache.kafka.",
            "com.zsumz.logyard.kafka.",
            "com.zsumz.logyard.slf4j17.",
            "org.slf4j.impl.",
        )
        for marker in forbidden_integrations:
            if marker in text:
                errors.append(
                    f"{source.relative_to(ROOT)}: removed integration marker {marker!r} remains"
                )

        if "java.nio.file.WatchService" in text and member != "logyard-runtime":
            errors.append(
                f"{source.relative_to(ROOT)}: WatchService is confined to logyard-runtime"
            )
        if ("java.nio.channels.FileLock" in text or ".tryLock(" in text) \
                and member != "logyard-output-json":
            errors.append(
                f"{source.relative_to(ROOT)}: file locking is confined to logyard-output-json"
            )

for source_root in SOURCE_ROOTS:
    for package_directory in sorted(
            directory for directory in source_root.rglob("*")
            if directory.is_dir()
            and any(source.name != "module-info.java" for source in directory.glob("*.java"))):
        package_info = package_directory / "package-info.java"
        if not package_info.is_file():
            errors.append(
                f"{package_directory.relative_to(ROOT)}: production package is missing package-info.java"
            )

api_source_root = ROOT / "modules/logyard-api/src/main/java"
spi_root = api_source_root / "com/zsumz/logyard/api/spi"
for source in sorted(spi_root.glob("*.java")):
    if source.name != "package-info.java":
        errors.append(
            f"{source.relative_to(ROOT)}: SPI contracts must live in a capability subpackage"
        )

config_root = ROOT / "modules/logyard-config-toml/src/main/java/com/zsumz/logyard/config"
config_root_types = {
    source.name
    for source in config_root.glob("*.java")
    if source.name != "package-info.java"
}
if config_root_types != {"ConfigurationException.java", "LogyardConfig.java"}:
    errors.append(
        "configuration root must contain only the aggregate and shared exception; found "
        + ", ".join(sorted(config_root_types))
    )

console_root = ROOT / "modules/logyard-output-console/src/main/java/com/zsumz/logyard/output/console"
console_root_types = {
    source.name
    for source in console_root.glob("*.java")
    if source.name != "package-info.java"
}
if console_root_types != {"ConsoleSink.java"}:
    errors.append(
        "console output root must contain only its delivery facade; found "
        + ", ".join(sorted(console_root_types))
    )

discovery_root = ROOT / "modules/logyard-runtime/src/main/java/com/zsumz/logyard/runtime/extension/discovery"
discovery_types = {
    source.name
    for source in discovery_root.glob("*.java")
    if source.name != "package-info.java"
}
expected_discovery_types = {
    "ContextProviderDiscovery.java",
    "EventEncoderProviderDiscovery.java",
    "EventProcessorProviderDiscovery.java",
    "NamedProviderDiscovery.java",
    "OutputProviderDiscovery.java",
    "TextFormatterProviderDiscovery.java",
}
if discovery_types != expected_discovery_types:
    errors.append(
        "extension discovery package is incomplete or misplaced; found "
        + ", ".join(sorted(discovery_types))
    )

delivery_root = ROOT / "modules/logyard-core/src/main/java/com/zsumz/logyard/core/delivery"
delivery_root_types = {
    source.name
    for source in delivery_root.glob("*.java")
    if source.name != "package-info.java"
}
if delivery_root_types != {"CompositeSink.java", "FilteringSink.java"}:
    errors.append(
        "core delivery root must contain only general sink decorators; found "
        + ", ".join(sorted(delivery_root_types))
    )

production_types: dict[str, str] = {}
for source, _ in main_files:
    if source.name == "package-info.java":
        continue
    text = source.read_text(encoding="utf-8")
    package_match = PACKAGE.search(text)
    if package_match is not None:
        package_name = package_match.group(1)
        production_types[f"{package_name}.{source.stem}"] = package_name

package_dependencies: dict[str, set[str]] = {}
for source, _ in main_files:
    text = source.read_text(encoding="utf-8")
    package_match = PACKAGE.search(text)
    if package_match is None:
        continue
    source_package = package_match.group(1)
    for imported in IMPORT.findall(text):
        candidate = imported.removesuffix(".*")
        target_package = None
        while "." in candidate and target_package is None:
            target_package = production_types.get(candidate)
            candidate = candidate.rsplit(".", 1)[0]
        if target_package is not None and target_package != source_package:
            package_dependencies.setdefault(source_package, set()).add(target_package)

next_package_index = 0
package_indices: dict[str, int] = {}
package_low_links: dict[str, int] = {}
package_stack: list[str] = []
packages_on_stack: set[str] = set()
package_components: list[set[str]] = []

def visit_package(package_name: str) -> None:
    global next_package_index
    package_indices[package_name] = next_package_index
    package_low_links[package_name] = next_package_index
    next_package_index += 1
    package_stack.append(package_name)
    packages_on_stack.add(package_name)

    for dependency in package_dependencies.get(package_name, set()):
        if dependency not in package_indices:
            visit_package(dependency)
            package_low_links[package_name] = min(
                package_low_links[package_name],
                package_low_links[dependency],
            )
        elif dependency in packages_on_stack:
            package_low_links[package_name] = min(
                package_low_links[package_name],
                package_indices[dependency],
            )

    if package_low_links[package_name] != package_indices[package_name]:
        return
    component: set[str] = set()
    while True:
        member = package_stack.pop()
        packages_on_stack.remove(member)
        component.add(member)
        if member == package_name:
            break
    if len(component) > 1:
        package_components.append(component)

for package_name in package_names:
    if package_name not in package_indices:
        visit_package(package_name)

allowed_api_facade_cycle = {
    "com.zsumz.logyard.api",
    "com.zsumz.logyard.api.diagnostics",
    "com.zsumz.logyard.api.event",
    "com.zsumz.logyard.api.ingress",
}
for component in package_components:
    if component != allowed_api_facade_cycle:
        errors.append(
            "production package dependency cycle: "
            + " <-> ".join(sorted(component))
        )

test_file_count = 0
test_method_count = 0
for source_root in TEST_ROOTS:
    for source in sorted(source_root.rglob("*.java")):
        java_sources.add(source.relative_to(ROOT).as_posix())
        test_file_count += 1
        relative = source.relative_to(source_root)
        expected_package = ".".join(relative.parent.parts)
        text = source.read_text(encoding="utf-8")
        test_method_count += len(re.findall(r"(?m)^\s*@Test\s*$", text))
        match = PACKAGE.search(text)
        if match is None:
            errors.append(f"{source.relative_to(ROOT)}: missing test package declaration")
        elif match.group(1) != expected_package:
            errors.append(
                f"{source.relative_to(ROOT)}: test package {match.group(1)!r} does not "
                f"match source path {expected_package!r}"
            )
        for imported in IMPORT.findall(text):
            if imported.endswith(".*"):
                errors.append(f"{source.relative_to(ROOT)}: wildcard imports are forbidden")

for source in EXAMPLE_JAVA_SOURCES:
    java_sources.add(source.relative_to(ROOT).as_posix())

production_sources = {source.relative_to(ROOT).as_posix() for source, _ in main_files}
for baseline_source in sorted(size_baseline.keys() - production_sources):
    errors.append(f"{SIZE_BASELINE.relative_to(ROOT)}: unknown production source {baseline_source}")

for source, _ in main_files:
    relative = source.relative_to(ROOT).as_posix()
    line_count = len(source.read_text(encoding="utf-8").splitlines())
    baseline_limit = size_baseline.get(relative)
    if baseline_limit is not None and line_count > baseline_limit:
        errors.append(
            f"{relative}: {line_count} lines exceeds its grandfathered {baseline_limit}-line ceiling; "
            "modified large production files may shrink but never grow"
        )
    elif baseline_limit is None and line_count > MAX_NEW_PRODUCTION_LINES:
        errors.append(
            f"{relative}: {line_count} lines exceeds the {MAX_NEW_PRODUCTION_LINES}-line production limit; "
            "extract a cohesive collaborator"
        )

for relative in sorted(java_sources - production_sources):
    source = ROOT / relative
    line_count = len(source.read_text(encoding="utf-8").splitlines())
    if line_count > MAX_TEST_OR_EXAMPLE_LINES:
        errors.append(
            f"{relative}: {line_count} lines exceeds the {MAX_TEST_OR_EXAMPLE_LINES}-line test/example limit; "
            "keep each file focused on one behavior family"
        )

manifest_versions: dict[str, str] = {}
for project_path, expected_dependencies in EXPECTED_DEPENDENCIES.items():
    manifest = ROOT / project_path / "zolt.toml"
    if not manifest.is_file():
        errors.append(f"{manifest.relative_to(ROOT)}: missing project manifest")
        continue
    text = manifest.read_text(encoding="utf-8")
    project_block = re.search(r"(?ms)^\[project\]\s*(.*?)(?=^\[|\Z)", text)
    if project_block is None:
        errors.append(f"{manifest.relative_to(ROOT)}: missing [project] block")
        continue
    block = project_block.group(1)
    name = re.search(r'(?m)^name\s*=\s*"([^"]+)"', block)
    version = re.search(r'(?m)^version\s*=\s*"([^"]+)"', block)
    group = re.search(r'(?m)^group\s*=\s*"([^"]+)"', block)
    java = re.search(r'(?m)^java\s*=\s*"([^"]+)"', block)
    expected_name = Path(project_path).name
    if name is None or name.group(1) != expected_name:
        errors.append(f"{manifest.relative_to(ROOT)}: project name must be {expected_name!r}")
    if version is None:
        errors.append(f"{manifest.relative_to(ROOT)}: missing version")
    else:
        manifest_versions[project_path] = version.group(1)
    if group is None or group.group(1) != "com.zsumz.logyard":
        errors.append(f"{manifest.relative_to(ROOT)}: group must be com.zsumz.logyard")
    if java is None or java.group(1) != "21":
        errors.append(f"{manifest.relative_to(ROOT)}: Java baseline must be 21")

    dependencies_match = re.search(r"(?ms)^\[dependencies\]\s*(.*?)(?=^\[|\Z)", text)
    dependency_block = dependencies_match.group(1) if dependencies_match else ""
    actual_dependencies = set(re.findall(r'(?m)^"([^"]+)"\s*=', dependency_block))
    if actual_dependencies != expected_dependencies:
        errors.append(
            f"{manifest.relative_to(ROOT)}: dependencies {sorted(actual_dependencies)} do not "
            f"match {sorted(expected_dependencies)}"
        )

versions = set(manifest_versions.values())
if len(versions) != 1:
    errors.append(
        "workspace versions must move together: "
        + ", ".join(f"{path}={version}" for path, version in sorted(manifest_versions.items()))
    )
else:
    version = next(iter(versions))
    version_source = ROOT / "modules/logyard-api/src/main/java/com/zsumz/logyard/api/LogyardVersion.java"
    if f'public static final String CURRENT = "{version}";' not in version_source.read_text():
        errors.append("LogyardVersion does not match the workspace version")
    if f"LOGYARD_SERVICE_VERSION:-{version}" not in (ROOT / "logyard.toml").read_text():
        errors.append("logyard.toml does not expose the workspace version")

for project_path, (expected_module, supported_packages) in ARTIFACT_CONTRACTS.items():
    descriptor = ROOT / project_path / "src/main/java/module-info.java"
    if descriptor.exists():
        errors.append(
            f"{descriptor.relative_to(ROOT)}: JPMS descriptors are deferred until Zolt packages modular Javadocs; "
            "use the stable Automatic-Module-Name and InternalApi boundary"
        )
    manifest = ROOT / project_path / "zolt.toml"
    manifest_text = manifest.read_text(encoding="utf-8")
    automatic_name = re.search(
        r'(?ms)^\[package\.manifest\]\s*.*?^"Automatic-Module-Name"\s*=\s*"([^"]+)"',
        manifest_text,
    )
    if automatic_name is None or automatic_name.group(1) != expected_module:
        errors.append(
            f"{manifest.relative_to(ROOT)}: Automatic-Module-Name must be {expected_module!r}"
        )
    for fragment in (
        'mode = "thin"',
        "sources = true",
        "javadoc = true",
        'license = "Apache-2.0"',
        'licenseUrl = "https://www.apache.org/licenses/LICENSE-2.0.txt"',
        'developers = ["zsumz <shawn@zsumz.com>"]',
        'url = "https://github.com/zsumz/logyard"',
        'scm = "https://github.com/zsumz/logyard"',
        'scmConnection = "scm:git:https://github.com/zsumz/logyard.git"',
        'scmDeveloperConnection = "scm:git:ssh://git@github.com/zsumz/logyard.git"',
        'issues = "https://github.com/zsumz/logyard/issues"',
        'artifacts = ["main"]',
        '[publish.signing]',
        'keyId = "EC8E4D26598A0373"',
        '[publish.central]',
        'tokenEnv = "ZOLT_CENTRAL_TOKEN"',
        'publishingType = "user-managed"',
    ):
        if fragment not in manifest_text:
            errors.append(f"{manifest.relative_to(ROOT)}: missing publication contract {fragment!r}")

    source_root = ROOT / project_path / "src/main/java"
    for package_info in sorted(source_root.rglob("package-info.java")):
        package_match = PACKAGE.search(package_info.read_text(encoding="utf-8"))
        if package_match is None:
            continue
        package_name = package_match.group(1)
        if package_name in supported_packages:
            continue
        package_text = package_info.read_text(encoding="utf-8")
        if "@com.zsumz.logyard.api.annotation.InternalApi" not in package_text:
            errors.append(
                f"{package_info.relative_to(ROOT)}: unsupported packages must declare @InternalApi"
            )

for manifest in sorted(
        path for group in ("modules", "tests", "benchmarks")
        for path in (ROOT / group).glob("*/zolt.toml")):
    text = manifest.read_text(encoding="utf-8")
    for coordinate, expected_version in {
        "org.junit.platform:junit-platform-console-standalone": "1.11.4",
        "org.slf4j:slf4j-api": "2.0.18",
        "org.openjdk.jmh:jmh-core": FRAMEWORK_VERSIONS["jmh"],
        "org.openjdk.jmh:jmh-generator-annprocess": FRAMEWORK_VERSIONS["jmh"],
    }.items():
        match = re.search(rf'(?m)^"{re.escape(coordinate)}"\s*=\s*"([^"]+)"', text)
        if match is not None and match.group(1) != expected_version:
            errors.append(
                f"{manifest.relative_to(ROOT)}: {coordinate} must use {expected_version}"
            )

SERVICE_CONTRACTS = {
    "modules/logyard-slf4j2/src/main/resources/META-INF/services/org.slf4j.spi.SLF4JServiceProvider":
        ["com.zsumz.logyard.slf4j.LogyardServiceProvider"],
    "modules/logyard-system-logger/src/main/resources/META-INF/services/java.lang.System$LoggerFinder":
        ["com.zsumz.logyard.systemlogger.LogyardLoggerFinder"],
    "tests/logyard-integration-tests/src/main/resources/META-INF/services/com.zsumz.logyard.api.spi.formatting.TextFormatterProvider":
        ["com.zsumz.logyard.tests.extensions.TestFormatterProvider"],
    "tests/logyard-integration-tests/src/main/resources/META-INF/services/com.zsumz.logyard.api.spi.encoding.EventEncoderProvider":
        ["com.zsumz.logyard.tests.extensions.TestEncoderProvider"],
    "tests/logyard-integration-tests/src/main/resources/META-INF/services/com.zsumz.logyard.api.spi.processing.EventProcessorProvider": [
        "com.zsumz.logyard.tests.extensions.TestEnricherProvider",
        "com.zsumz.logyard.tests.extensions.TestFilterProvider",
    ],
    "tests/logyard-integration-tests/src/main/resources/META-INF/services/com.zsumz.logyard.api.spi.output.OutputProvider":
        ["com.zsumz.logyard.tests.extensions.TestOutputProvider"],
}
for relative, expected in SERVICE_CONTRACTS.items():
    descriptor = ROOT / relative
    if not descriptor.is_file():
        errors.append(f"{relative}: missing ServiceLoader descriptor")
        continue
    actual = [
        line.strip()
        for line in descriptor.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]
    if actual != expected:
        errors.append(f"{relative}: expected {expected}, found {actual}")

runtime_sources = [
    (source, source.read_text(encoding="utf-8"))
    for source in sorted((ROOT / "modules/logyard-runtime/src/main/java").rglob("*.java"))
]
reload_coordinator_source = ROOT / "modules/logyard-runtime/src/main/java/com/zsumz/logyard/runtime/reload/ReloadCoordinator.java"
reload_coordinator_text = reload_coordinator_source.read_text(encoding="utf-8")
if "synchronized" in reload_coordinator_text or "ReentrantLock" in reload_coordinator_text:
    errors.append(
        f"{reload_coordinator_source.relative_to(ROOT)}: reload coordination must use non-blocking generation ownership"
    )

reload_state_source = ROOT / "modules/logyard-runtime/src/main/java/com/zsumz/logyard/runtime/reload/ReloadState.java"
reload_state_text = reload_state_source.read_text(encoding="utf-8")
for forbidden_state_collaborator in (
    "ConfigurationSnapshotReader",
    "LogyardRuntimeFactory",
    "ReloadDiagnostics",
    "java.io.",
    "java.nio.file.",
    "Provider",
):
    if forbidden_state_collaborator in reload_state_text:
        errors.append(
            f"{reload_state_source.relative_to(ROOT)}: atomic reload state must not invoke or own "
            f"{forbidden_state_collaborator}"
        )

managed_installation_source = (
    ROOT / "modules/logyard-runtime/src/main/java/com/zsumz/logyard/runtime/installation/ManagedRuntimeInstallation.java"
)
managed_installation_text = managed_installation_source.read_text(encoding="utf-8")
if "synchronized" in managed_installation_text or "ReentrantLock" in managed_installation_text:
    errors.append(
        f"{managed_installation_source.relative_to(ROOT)}: managed installation publication must not run under a lock"
    )

if not any(
        re.search(
            r"output\s+instanceof\s+CustomOutputConfig.*?new\s+AsyncSink\(.*?false\s*\)",
            text,
            re.DOTALL,
        )
        for _, text in runtime_sources
):
    errors.append("custom outputs must be wrapped in AsyncSink with caller-thread delivery disabled")

processor_names_declaration = re.compile(
    r"(?:public|protected|private)?\s+static\s+List<String>\s+processorNames\s*\("
)
processor_methods = [
    (source, text, match)
    for source, text in runtime_sources
    if (match := processor_names_declaration.search(text)) is not None
]
if len(processor_methods) != 1:
    errors.append(f"expected one processorNames method, found {len(processor_methods)}")
    processor_section = ""
else:
    processor_source, processor_text, processor_match = processor_methods[0]
    processor_start = processor_match.start()
    processor_open_brace = processor_text.index("{", processor_start)
    processor_depth = 0
    processor_end = None
    for index in range(processor_open_brace, len(processor_text)):
        if processor_text[index] == "{":
            processor_depth += 1
        elif processor_text[index] == "}":
            processor_depth -= 1
            if processor_depth == 0:
                processor_end = index + 1
                break
    if processor_end is None:
        errors.append(f"{processor_source.relative_to(ROOT)}: processorNames method has no balanced closing brace")
        processor_section = ""
    else:
        processor_section = processor_text[processor_start:processor_end]
processor_order = (
    processor_section.find("result.add(CONTEXT_PROCESSOR)"),
    processor_section.find("result.addAll(safe(rule.filters()))"),
    processor_section.find("result.addAll(safe(rule.enrich()))"),
    processor_section.find("result.add(REDACTION_PROCESSOR)"),
)
if any(index < 0 for index in processor_order) or list(processor_order) != sorted(processor_order):
    errors.append("processor order must remain context, filters, enrichers, redaction")

FAILURE_BOUNDARY_CONTRACTS = {
