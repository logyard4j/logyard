for relative, fragments in BOUND_CONTRACTS.items():
    text = (ROOT / relative).read_text(encoding="utf-8")
    for fragment in fragments:
        if fragment not in text:
            errors.append(f"{relative}: missing bound contract {fragment!r}")

def integer_constant(relative: str, name: str) -> int | None:
    text = (ROOT / relative).read_text(encoding="utf-8")
    match = re.search(rf"\b{re.escape(name)}\s*=\s*([0-9][0-9_]*)\s*;", text)
    if match is None:
        errors.append(f"{relative}: missing integer constant {name}")
        return None
    return int(match.group(1).replace("_", ""))

output_limit = integer_constant(
    "modules/logyard-config-toml/src/main/java/com/zsumz/logyard/config/loading/OutputSectionDecoder.java",
    "MAXIMUM_OUTPUTS",
)
flush_worker_limit = integer_constant(
    "modules/logyard-output-json/src/main/java/com/zsumz/logyard/output/json/flush/BoundedElasticFlushDispatcher.java",
    "MAXIMUM_WORKERS",
)
if output_limit is not None and flush_worker_limit is not None and flush_worker_limit < output_limit:
    errors.append(
        "shared JSON flush worker capacity must support every output allowed in one active configuration"
    )

flush_diagnostics = (
    ROOT / "modules/logyard-output-json/src/main/java/com/zsumz/logyard/output/json/flush/FlushDiagnostics.java"
).read_text(encoding="utf-8")
if "Executor" in flush_diagnostics or "BlockingQueue" in flush_diagnostics:
    errors.append("timed-flush diagnostics must not retain an executor or diagnostic queue")

for relative in (
    "modules/logyard-jul/src/main/java/com/zsumz/logyard/jul/LogyardHandler.java",
    "modules/logyard-system-logger/src/main/java/com/zsumz/logyard/systemlogger/internal/factory/LogyardSystemLogger.java",
    "modules/logyard-slf4j2/src/main/java/com/zsumz/logyard/slf4j/internal/logger/LogyardSlf4jLogger.java",
):
    text = (ROOT / relative).read_text(encoding="utf-8")
    if "AdapterReentryGuard" not in text or ".enter()" not in text or ".exit()" not in text:
        errors.append(f"{relative}: adapter ingress must use the shared recursion guard")

slf4j_logger = (
    ROOT / "modules/logyard-slf4j2/src/main/java/com/zsumz/logyard/slf4j/internal/logger/LogyardSlf4jLogger.java"
).read_text(encoding="utf-8")
if "LocationAwareLogger" in slf4j_logger:
    errors.append("LogyardSlf4jLogger must not implement LocationAwareLogger")
if "LoggingEventAware" not in slf4j_logger:
    errors.append("LogyardSlf4jLogger must implement LoggingEventAware")

fallback_stub_root = ROOT / "scripts/verify-support/junit-stub-src"
for candidate in sorted((ROOT / "modules").glob("*/src/test/java/**/*.java")):
    if "@TempDir" in candidate.read_text(encoding="utf-8"):
        errors.append(
            f"{candidate.relative_to(ROOT)}: fallback-suite tests must create temporary directories explicitly"
        )
for candidate in sorted(ROOT.rglob("*.java")):
    if "target" in candidate.parts:
        continue
    text = candidate.read_text(encoding="utf-8")
    if re.search(r"(?m)^package\s+org\.junit(?:\.|;)", text) and not candidate.is_relative_to(fallback_stub_root):
        errors.append(f"{candidate.relative_to(ROOT)}: checked-in JUnit substitutes are forbidden")

if errors:
    for error in errors:
        print(f"architecture check failed: {error}", file=sys.stderr)
    raise SystemExit(1)

print(
    "Architecture checks passed: "
    f"{len(main_files)} main Java files, {test_file_count} test files, "
    f"{test_method_count} JUnit tests, {len(EXPECTED_DEPENDENCIES)} projects, "
    "bounded runtime and extension contracts."
)
