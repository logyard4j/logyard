#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${LOGYARD_JAVADOC_TARGET:-$ROOT/target/javadoc}"
JAVADOC="${JAVADOC:-javadoc}"

export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT/scripts"
source_list="$(python3 -m verify_tools.supported_api "$ROOT" javadoc-sources)"
root_list="$(python3 -m verify_tools.supported_api "$ROOT" javadoc-roots)"
sources=()
while IFS= read -r source; do
  sources+=("$source")
done <<< "$source_list"
source_roots=()
while IFS= read -r source_root; do
  source_roots+=("$source_root")
done <<< "$root_list"

mkdir -p "$TARGET"
CLASSPATH="$(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT/scripts" python3 -m verify_tools.javadoc_classpath "$ROOT")"
SOURCE_PATH="$(IFS=:; printf '%s' "${source_roots[*]}")"
"$JAVADOC" \
  --release 21 \
  -encoding UTF-8 \
  -docencoding UTF-8 \
  -charset UTF-8 \
  -notimestamp \
  -quiet \
  -Werror \
  -Xdoclint:all \
  -classpath "$CLASSPATH" \
  -sourcepath "$SOURCE_PATH" \
  -d "$TARGET" \
  "${sources[@]}"

printf 'Strict Javadocs generated for %d supported source files: %s\n' "${#sources[@]}" "$TARGET"
