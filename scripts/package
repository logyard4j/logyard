#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/logyard-release.sh"

ZOLT="$(logyard_require_zolt)"
ZOLT_JAVA_HOME="$(logyard_jdk_home)"
members="$(logyard_publish_members | paste -sd, -)"
STAGING="$ROOT/target/maven-build-repository"
MAVEN_CACHE="$ROOT/target/maven-package-repository"
STAGING_URI="$(logyard_file_uri "$STAGING")"

JAVA_HOME="$ZOLT_JAVA_HOME" PATH="$ZOLT_JAVA_HOME/bin:$PATH" "$ZOLT" package \
  --directory "$ROOT" \
  --workspace \
  --members "$members" \
  --no-progress \
  --color never

logyard_stage_native_repository "$STAGING"

rm -rf "$MAVEN_CACHE"
mkdir -p "$MAVEN_CACHE"
cp -R "$STAGING/." "$MAVEN_CACHE/"

mvn --batch-mode --no-transfer-progress \
  -f "$ROOT/extensions/logyard-quarkus/pom.xml" \
  -Dmaven.repo.local="$MAVEN_CACHE" \
  -Dlogyard.repository="$STAGING_URI" \
  package
