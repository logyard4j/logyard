#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fail() {
  printf 'repository check failed: %s\n' "$1" >&2
  exit 1
}

for removed in docs apps; do
  [[ ! -e "$removed" ]] || fail "$removed should not exist in the core-focused package"
done

declared_members=()
while IFS= read -r member; do
  declared_members+=("$member")
done < <(
  awk '
    /^\[workspace\.members\]$/ { members = 1; next }
    members && /^include = \[/ { inside = 1; next }
    inside && /^]/ { exit }
    inside && match($0, /"[^"]+"/) {
      print substr($0, RSTART + 1, RLENGTH - 2)
    }
  ' zolt.toml | sort
)
actual_members=()
while IFS= read -r member; do
  actual_members+=("$member")
done < <(
  find modules tests benchmarks -mindepth 2 -maxdepth 2 -name zolt.toml -print \
    | sed 's#/zolt\.toml$##' \
    | sort
)
if ! diff -u \
    <(printf '%s\n' "${declared_members[@]}") \
    <(printf '%s\n' "${actual_members[@]}"); then
  fail 'root zolt.toml members do not match project manifests'
fi

for member in "${actual_members[@]}"; do
  if grep -Fq '[bom]' "$member/zolt.toml"; then
    continue
  fi
  [[ -d "$member/src/main/java" ]] || fail "$member has no src/main/java directory"
done

required_files=(
  README.md
  RELEASING.md
  compatibility-baseline.toml
  supported-api.toml
  framework-versions.toml
  LICENSE
  NOTICE
  logyard.toml
  zolt.toml
  scripts/ci
  scripts/api-compatibility
  scripts/benchmark-smoke
  scripts/failure-injection-verify
  scripts/framework-versions-check
  benchmarks/allocation-budgets.json
  scripts/javadoc
  scripts/package-verify
  scripts/package
  scripts/central-publish
  scripts/zolt-publication-check
  scripts/examples-verify
  scripts/release-bundle
  scripts/release-verify
  scripts/lib/logyard-release.sh
  modules/logyard-bom/zolt.toml
  modules/logyard-spring-boot-starter/zolt.toml
  modules/logyard-spring-boot/src/main/resources/META-INF/spring.factories
  modules/logyard-spring-boot/src/main/resources/META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports
  examples/slf4j/zolt.toml
  examples/vertx/zolt.toml
  examples/micronaut/zolt.toml
  examples/spring-boot/zolt.toml
  examples/quarkus/zolt.toml
  examples/quarkus/src/main/resources/application.properties
  extensions/logyard-quarkus/pom.xml
  extensions/logyard-quarkus/runtime/pom.xml
  extensions/logyard-quarkus/runtime/src/main/resources/META-INF/quarkus-extension.yaml
  extensions/logyard-quarkus/deployment/pom.xml
  extensions/logyard-quarkus/deployment/src/main/java/com/logyard4j/logyard/quarkus/deployment/LogyardQuarkusProcessor.java
  scripts/example_tools/zolt.py
  smoke/examples.smoke.mts
  scripts/verify
  scripts/architecture-check
  scripts/java-size-baseline.tsv
  modules/logyard-slf4j2/src/main/resources/META-INF/services/org.slf4j.spi.SLF4JServiceProvider
  'modules/logyard-system-logger/src/main/resources/META-INF/services/java.lang.System$LoggerFinder'
  tests/logyard-integration-tests/src/main/resources/META-INF/services/com.logyard4j.logyard.api.spi.formatting.TextFormatterProvider
  tests/logyard-integration-tests/src/main/resources/META-INF/services/com.logyard4j.logyard.api.spi.encoding.EventEncoderProvider
  tests/logyard-integration-tests/src/main/resources/META-INF/services/com.logyard4j.logyard.api.spi.processing.EventProcessorProvider
  tests/logyard-integration-tests/src/main/resources/META-INF/services/com.logyard4j.logyard.api.spi.output.OutputProvider
)
for required in "${required_files[@]}"; do
  [[ -f "$required" ]] || fail "required file is missing: $required"
done

generated_python_artifact="$(
  find . -path './.git' -prune -o -path './.zolt' -prune -o -path '*/target' -prune -o \
    \( -type d -name __pycache__ -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) -print -quit
)"
[[ -z "$generated_python_artifact" ]] || fail "generated Python bytecode is present: $generated_python_artifact"

while IFS= read -r python_source; do
  source_lines="$(wc -l < "$python_source")"
  [[ "$source_lines" -le 300 ]] || fail "$python_source exceeds the 300-line Python tooling limit"
done < <(find scripts/architecture_tools scripts/benchmark_tools scripts/comparison_tools scripts/example_tools scripts/verify_tools -type f -name '*.py' -print | sort)

if find . -path './.git' -prune -o -path './.zolt' -prune -o \
    -path './target' -prune -o \
    -path './extensions/logyard-quarkus' -prune -o \
    \( -name pom.xml -o -name build.gradle -o -name build.gradle.kts \
       -o -name settings.gradle -o -name settings.gradle.kts \) -print | grep -q .; then
  fail 'Maven or Gradle project files are checked in outside the Quarkus extension reactor; Zolt is the default project model'
fi

while IFS= read -r script; do
  [[ -f "$script" ]] || continue
  bash -n "$script"
done < <(find scripts -type f \( -path 'scripts/lib/*.sh' -o -perm -u+x \) -print | sort)

if grep -R -nE 'uses: [^[:space:]]+@(main|master|v[0-9]+([.][0-9]+)*)($|[[:space:]])' .github/workflows; then
  fail 'GitHub Actions must use immutable commit SHAs'
fi

for package in scripts/benchmark_tools scripts/comparison_tools scripts/example_tools scripts/verify_tools; do
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT/scripts" python3 -m unittest discover -s "$package" -t scripts -p 'test_*.py'
done

./scripts/framework-versions-check
PYTHONPATH="$ROOT/scripts" python3 -m verify_tools.legal_notices "$ROOT"
./scripts/architecture-check

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --check
fi

printf 'Repository checks passed: %d focused Zolt projects and shell/build contracts.\n' \
  "${#actual_members[@]}"
