#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"

[[ -x "$ZOLT" ]] || {
  printf 'failure-injection verification requires Zolt at %s\n' "$ZOLT" >&2
  exit 2
}

run_suite() {
  local member="$1"
  shift
  local -a arguments=("$@") selected=()
  local index
  for ((index = 0; index < ${#arguments[@]}; index++)); do
    if [[ "${arguments[index]}" == "--test" ]]; then
      selected+=("${arguments[index + 1]%%#*}")
    fi
  done
  rm -rf "$ROOT/$member/target/failure-injection-reports"
  "$ZOLT" test --directory "$ROOT" --workspace --member "$member" \
    --reports-dir target/failure-injection-reports "$@"
  PYTHONPATH="$ROOT/scripts" python3 -m verify_tools.junit_reports \
    "$ROOT/$member/target/failure-injection-reports" "${selected[@]}"
}

run_suite modules/logyard-output-json \
  --test com.logyard4j.logyard.output.json.encoding.JsonEncoderConcurrencyTest \
  --test com.logyard4j.logyard.output.json.file.FileDurabilityTest \
  --test com.logyard4j.logyard.output.json.file.TimedDurabilityTest \
  --test com.logyard4j.logyard.output.json.file.ActiveDataFileFailureTest \
  --test com.logyard4j.logyard.output.json.file.JsonFileSinkInitializationTest \
  --test com.logyard4j.logyard.output.json.file.JsonFileSinkIdentityTest \
  --test com.logyard4j.logyard.output.json.file.JsonFileFlushConcurrencyTest \
  --test com.logyard4j.logyard.output.json.file.JsonFileTimedFlushTest \
  --test com.logyard4j.logyard.output.json.file.RotatingFileWriterFailureTest \
  --test com.logyard4j.logyard.output.json.file.rotation.ArchiveMaintenanceLifecycleTest \
  --test com.logyard4j.logyard.output.json.flush.FlushDispatcherSinkSaturationTest \
  --test com.logyard4j.logyard.output.json.flush.FlushDiagnosticsTest \
  --test com.logyard4j.logyard.output.json.flush.TimedFlushConcurrencyTest \
  --test com.logyard4j.logyard.output.json.flush.TimedFlushFailureIsolationTest \
  --test com.logyard4j.logyard.output.json.flush.BoundedElasticFlushDispatcherTest \
  --test com.logyard4j.logyard.output.json.stream.JsonLinesFlushConcurrencyTest \
  --test com.logyard4j.logyard.output.json.stream.JsonLinesFatalFailureTest \
  --test com.logyard4j.logyard.output.json.stream.JsonLinesSinkCloseFailureTest \
  --test com.logyard4j.logyard.output.json.stream.JsonLinesSinkFailureTest \
  --test com.logyard4j.logyard.output.json.stream.JsonLinesTimedFlushTest \
  --jvm-arg=-Djdk.virtualThreadScheduler.parallelism=2 \
  --jvm-arg=-Djdk.virtualThreadScheduler.maxPoolSize=2 \
  --no-progress \
  --color never

run_suite modules/logyard-runtime \
  --test com.logyard4j.logyard.runtime.assembly.output.FileOutputReloadIdentityTest \
  --test com.logyard4j.logyard.runtime.assembly.output.DeliveryAssemblerOwnershipTest \
  --test com.logyard4j.logyard.runtime.assembly.OutputAssemblerTest \
  --test com.logyard4j.logyard.runtime.assembly.RuntimeJsonConcurrencyTest \
  --test com.logyard4j.logyard.runtime.installation.process.FileOutputInstallationFailureTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.DuplicateOutputReloadTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.ContextPolicyReloadTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.FileOutputReloadPublicationFailureTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.RejectedConfigurationReconciliationTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.ReloadCoordinatorTransientResourceTest \
  --test com.logyard4j.logyard.runtime.reload.watcher.ReloadDebouncerTest \
  --test com.logyard4j.logyard.runtime.reload.coordination.ReloadFailureClassifierTest \
  --no-progress \
  --color never

printf 'Focused durable-resource and reload failure-injection verification passed.\n'
