#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"

[[ -x "$ZOLT" ]] || {
  printf 'failure-injection verification requires Zolt at %s\n' "$ZOLT" >&2
  exit 2
}

"$ZOLT" test \
  --directory "$ROOT" \
  --workspace \
  --member modules/logyard-output-json \
  --test com.zsumz.logyard.output.json.encoding.JsonEncoderConcurrencyTest \
  --test com.zsumz.logyard.output.json.file.ActiveDataFileFailureTest \
  --test com.zsumz.logyard.output.json.file.JsonFileSinkInitializationTest \
  --test com.zsumz.logyard.output.json.file.JsonFileSinkIdentityTest \
  --test com.zsumz.logyard.output.json.file.JsonFileFlushConcurrencyTest \
  --test com.zsumz.logyard.output.json.file.JsonFileTimedFlushTest \
  --test com.zsumz.logyard.output.json.file.RotatingFileWriterFailureTest \
  --test com.zsumz.logyard.output.json.file.rotation.ArchiveMaintenanceLifecycleTest \
  --test com.zsumz.logyard.output.json.flush.TimedFlushConcurrencyTest \
  --test com.zsumz.logyard.output.json.flush.BoundedElasticFlushDispatcherTest \
  --test com.zsumz.logyard.output.json.stream.JsonLinesFlushConcurrencyTest \
  --test com.zsumz.logyard.output.json.stream.JsonLinesFatalFailureTest \
  --test com.zsumz.logyard.output.json.stream.JsonLinesSinkCloseFailureTest \
  --test com.zsumz.logyard.output.json.stream.JsonLinesSinkFailureTest \
  --test com.zsumz.logyard.output.json.stream.JsonLinesTimedFlushTest \
  --jvm-arg=-Djdk.virtualThreadScheduler.parallelism=2 \
  --jvm-arg=-Djdk.virtualThreadScheduler.maxPoolSize=2 \
  --no-progress \
  --color never

"$ZOLT" test \
  --directory "$ROOT" \
  --workspace \
  --member modules/logyard-runtime \
  --test com.zsumz.logyard.runtime.assembly.output.DeliveryAssemblerOwnershipTest \
  --test com.zsumz.logyard.runtime.assembly.OutputAssemblerTest \
  --test com.zsumz.logyard.runtime.assembly.RuntimeJsonConcurrencyTest \
  --test com.zsumz.logyard.runtime.installation.FileOutputInstallationFailureTest \
  --test com.zsumz.logyard.runtime.reload.DuplicateOutputReloadTest \
  --test com.zsumz.logyard.runtime.reload.ContextPolicyReloadTest \
  --test com.zsumz.logyard.runtime.reload.FileOutputReloadPublicationFailureTest \
  --test com.zsumz.logyard.runtime.reload.RejectedConfigurationReconciliationTest \
  --test com.zsumz.logyard.runtime.reload.ReloadCoordinatorTransientResourceTest \
  --test com.zsumz.logyard.runtime.reload.ReloadDebouncerTest \
  --test com.zsumz.logyard.runtime.reload.ReloadFailureClassifierTest \
  --no-progress \
  --color never

printf 'Focused durable-resource and reload failure-injection verification passed.\n'
