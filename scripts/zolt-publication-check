#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"
VERSION="$(PYTHONPATH="$ROOT/scripts" python3 -m release_tools.manifest_cli version "$ROOT")"
mkdir -p "$ROOT/target"
REPORT="$(mktemp "$ROOT/target/zolt-central-readiness.XXXXXX")"

cleanup() {
  rm -f "$REPORT"
}
trap cleanup EXIT

"$ROOT/scripts/package-verify"

set +e
"$ZOLT" publish \
  --directory "$ROOT" \
  --workspace \
  --all \
  --dry-run \
  --central \
  --no-progress \
  --color never \
  >"$REPORT" 2>&1
status=$?
set -e

cat "$REPORT"

if [[ "$status" -eq 0 ]]; then
  printf 'Zolt Central publication preflight passed for release %s.\n' "$VERSION"
  exit 0
fi

expected_members="$(PYTHONPATH="$ROOT/scripts" python3 -m release_tools.manifest_cli zolt-members "$ROOT" | tr ',' '\n' | wc -l | tr -d ' ')"
expected_jars="$(PYTHONPATH="$ROOT/scripts" python3 -m release_tools.manifest_cli jar-members "$ROOT" | tr ',' '\n' | wc -l | tr -d ' ')"
blockers="$(awk '/^Blockers:$/ { inside = 1; next } inside && /^- / { print }' "$REPORT")"
actual_blockers="$(printf '%s\n' "$blockers" | sed '/^$/d' | wc -l | tr -d ' ')"
version_blockers="$(printf '%s\n' "$blockers" | grep -Fc ': release version —' || true)"
sources_blockers="$(printf '%s\n' "$blockers" | grep -Fc ': sources jar —' || true)"
javadoc_blockers="$(printf '%s\n' "$blockers" | grep -Fc ': javadoc jar —' || true)"
unexpected_blockers="$(printf '%s\n' "$blockers" | sed '/^$/d' | grep -Ev ': (release version|sources jar|javadoc jar) —' || true)"
expected_version_blockers=0
if [[ "$VERSION" == *-SNAPSHOT ]]; then
  expected_version_blockers="$expected_members"
fi
expected_blockers=$((expected_version_blockers + expected_jars * 2))

[[ "$actual_blockers" -eq "$expected_blockers" ]] || {
  printf 'Expected %s known blockers from Zolt %s; found %s.\n' "$expected_blockers" "$VERSION" "$actual_blockers" >&2
  exit 1
}
[[ "$version_blockers" -eq "$expected_version_blockers" ]] || {
  printf 'Expected %s release-version blockers; found %s.\n' "$expected_version_blockers" "$version_blockers" >&2
  exit 1
}
[[ "$sources_blockers" -eq "$expected_jars" && "$javadoc_blockers" -eq "$expected_jars" ]] || {
  printf 'Expected the pinned Zolt family planner to report its known supplemental-planning limitation for %s JAR members; found %s sources and %s Javadocs blockers.\n' "$expected_jars" "$sources_blockers" "$javadoc_blockers" >&2
  exit 1
}
[[ -z "$unexpected_blockers" ]] || {
  printf 'Zolt Central publication preflight found unexpected blockers:\n%s\n' "$unexpected_blockers" >&2
  exit 1
}

printf 'Zolt family metadata is Central-ready for all %s members; package verification independently proved all %s sources and Javadoc pairs omitted by this pinned family planner.\n' "$expected_members" "$expected_jars"
if [[ "$VERSION" == *-SNAPSHOT ]]; then
  printf '%s remains correctly blocked as a Central release version.\n' "$VERSION"
fi
