#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/logyard-release.sh"

ZOLT="$(logyard_require_zolt)"
ZOLT_JAVA_HOME="$(logyard_jdk_home)"
VERSION="$(logyard_release_version)"
mkdir -p "$ROOT/target"
REPORT="$(mktemp "$ROOT/target/zolt-central-readiness.XXXXXX")"

cleanup() {
  rm -f "$REPORT"
}
trap cleanup EXIT

"$ROOT/scripts/package-verify"

set +e
JAVA_HOME="$ZOLT_JAVA_HOME" PATH="$ZOLT_JAVA_HOME/bin:$PATH" "$ZOLT" publish \
  --directory "$ROOT" \
  --workspace \
  --all \
  --dry-run \
  --central \
  --no-progress \
  --color never \
  >"$REPORT" 2>&1
status=$?
set -e

cat "$REPORT"

if [[ "$status" -eq 0 ]]; then
  printf 'Zolt Central publication preflight passed for release %s.\n' "$VERSION"
  exit 0
fi

if [[ "$VERSION" != *-SNAPSHOT ]]; then
  printf 'Zolt Central publication preflight failed for release %s.\n' "$VERSION" >&2
  exit 1
fi

expected_members="$(logyard_publish_member_count)"
blockers="$(awk '/^Blockers:$/ { inside = 1; next } inside && /^- / { print }' "$REPORT")"
actual_blockers="$(printf '%s\n' "$blockers" | sed '/^$/d' | wc -l | tr -d ' ')"
version_blockers="$(printf '%s\n' "$blockers" | grep -Fc ': release version —' || true)"
unexpected_blockers="$(printf '%s\n' "$blockers" | sed '/^$/d' | grep -Ev ': release version —' || true)"
expected_version_blockers=0
if [[ "$VERSION" == *-SNAPSHOT ]]; then
  expected_version_blockers="$expected_members"
fi

[[ "$actual_blockers" -eq "$expected_version_blockers" ]] || {
  printf 'Expected %s release-version blockers from Zolt %s; found %s.\n' "$expected_version_blockers" "$VERSION" "$actual_blockers" >&2
  exit 1
}
[[ "$version_blockers" -eq "$expected_version_blockers" ]] || {
  printf 'Expected %s release-version blockers; found %s.\n' "$expected_version_blockers" "$version_blockers" >&2
  exit 1
}
[[ -z "$unexpected_blockers" ]] || {
  printf 'Zolt Central publication preflight found unexpected blockers:\n%s\n' "$unexpected_blockers" >&2
  exit 1
}

printf 'Zolt planned the complete Central artifact set for all %s native workspace publications.\n' "$expected_members"
if [[ "$VERSION" == *-SNAPSHOT ]]; then
  printf '%s remains correctly blocked as a Central release version.\n' "$VERSION"
fi
