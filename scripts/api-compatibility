#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/logyard-release.sh"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"
JAPICMP_VERSION="0.26.1"
JAPICMP_SHA256="4b4f0301861d97cd2a05af3f7fa9173cc1dd3831b1284b2b9e2f81c4f1c2f858"
TOOL_DIR="$ROOT/target/tools"
JAPICMP_JAR="$TOOL_DIR/japicmp-$JAPICMP_VERSION.jar"
CURRENT_DIR="$ROOT/target/api-compatibility"
BASELINE_MANIFEST="$ROOT/compatibility-baseline.toml"
BASELINE_DIR="$CURRENT_DIR/baseline"

usage() {
  cat <<'USAGE'
Usage:
  scripts/api-compatibility --baseline
  scripts/api-compatibility OLD_API_JAR OLD_RUNTIME_JAR OLD_JUL_JAR OLD_SPRING_JAR OLD_QUARKUS_JAR
  scripts/api-compatibility --self-test

--baseline enforces compatibility against the checksummed release declared in
compatibility-baseline.toml, or confirms an explicit "none" policy before the
first public release. --self-test checks only japicmp wiring and include filters.
USAGE
}

digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

require_file() {
  [[ -f "$1" ]] || {
    printf 'error: required jar does not exist: %s\n' "$1" >&2
    exit 2
  }
}

baseline_value() {
  local key="$1"
  sed -n "/^\[artifacts\]/q; s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*$/\\1/p" \
    "$BASELINE_MANIFEST" | head -n 1
}

baseline_artifact_value() {
  local surface="$1"
  local field="$2"
  local line
  line="$(sed -n "/^[[:space:]]*$surface[[:space:]]*=/p" "$BASELINE_MANIFEST" | head -n 1)"
  [[ -n "$line" ]] || return
  printf '%s\n' "$line" | sed -n "s/.*$field[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
}

fetch_baseline_artifact() {
  local surface="$1"
  local artifact checksum group repository source temporary destination actual
  artifact="$(baseline_artifact_value "$surface" artifact)"
  checksum="$(baseline_artifact_value "$surface" sha256)"
  [[ -n "$artifact" && "$checksum" =~ ^[0-9a-f]{64}$ ]] || {
    printf 'error: compatibility baseline artifact %s is incomplete\n' "$surface" >&2
    exit 2
  }
  group="$(baseline_value group)"
  group="${group:-com.zsumz.logyard}"
  repository="$(baseline_value repository)"
  [[ -n "$repository" ]] || {
    printf 'error: compatibility baseline has no repository\n' >&2
    exit 2
  }
  source="${repository%/}/$(logyard_group_path "$group")/$artifact/$baseline_version/$artifact-$baseline_version.jar"
  destination="$BASELINE_DIR/$artifact-$baseline_version.jar"
  mkdir -p "$BASELINE_DIR"
  temporary="$(mktemp "$BASELINE_DIR/.${artifact}.XXXXXX")"
  if ! curl -fsSL "$source" -o "$temporary"; then
    rm -f "$temporary"
    printf 'error: unable to fetch compatibility baseline artifact: %s\n' "$source" >&2
    exit 2
  fi
  actual="$(digest "$temporary")"
  [[ "$actual" == "$checksum" ]] || {
    rm -f "$temporary"
    printf 'error: compatibility baseline checksum mismatch for %s\n' "$artifact" >&2
    exit 2
  }
  mv "$temporary" "$destination"
  printf '%s\n' "$destination"
}

install_japicmp() {
  mkdir -p "$TOOL_DIR"
  if [[ ! -f "$JAPICMP_JAR" ]]; then
    curl -fsSL \
      -o "$JAPICMP_JAR" \
      "https://repo.maven.apache.org/maven2/com/github/siom79/japicmp/japicmp/$JAPICMP_VERSION/japicmp-$JAPICMP_VERSION-jar-with-dependencies.jar"
  fi
  local actual
  actual="$(digest "$JAPICMP_JAR")"
  [[ "$actual" == "$JAPICMP_SHA256" ]] || {
    printf 'error: japicmp checksum mismatch: expected %s, found %s\n' "$JAPICMP_SHA256" "$actual" >&2
    exit 2
  }
}

build_current_jars() {
  "$ZOLT" build --directory "$ROOT" --workspace \
    --members modules/logyard-api,modules/logyard-runtime,modules/logyard-jul,modules/logyard-spring-boot \
    --no-progress --color never
  "$ROOT/scripts/package"
  mkdir -p "$CURRENT_DIR"
  jar --create --file "$CURRENT_DIR/logyard-api-current.jar" -C "$ROOT/modules/logyard-api/target/classes" .
  jar --create --file "$CURRENT_DIR/logyard-runtime-current.jar" -C "$ROOT/modules/logyard-runtime/target/classes" .
  jar --create --file "$CURRENT_DIR/logyard-jul-current.jar" -C "$ROOT/modules/logyard-jul/target/classes" .
  jar --create --file "$CURRENT_DIR/logyard-spring-boot-current.jar" -C "$ROOT/modules/logyard-spring-boot/target/classes" .
  local quarkus_jar
  quarkus_jar="$(find "$ROOT/extensions/logyard-quarkus/runtime/target" -maxdepth 1 -type f \
    -name 'logyard-quarkus-*.jar' ! -name '*-sources.jar' ! -name '*-javadoc.jar' -print -quit)"
  require_file "$quarkus_jar"
  cp "$quarkus_jar" "$CURRENT_DIR/logyard-quarkus-current.jar"
}

compare() {
  local old_jar="$1"
  local new_jar="$2"
  local include="$3"
  java -jar "$JAPICMP_JAR" \
    --old "$old_jar" \
    --new "$new_jar" \
    --include "$include" \
    --only-modified \
    --ignore-missing-classes \
    --error-on-binary-incompatibility \
    --error-on-source-incompatibility
}

mode=""
if [[ "$#" -eq 1 && "$1" == "--baseline" ]]; then
  [[ "$(sed -n 's/^[[:space:]]*schema[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$BASELINE_MANIFEST" | head -n 1)" == 1 ]] || {
    printf 'error: compatibility baseline schema must be 1\n' >&2
    exit 2
  }
  baseline_version="$(baseline_value version)"
  [[ -n "$baseline_version" ]] || {
    printf 'error: compatibility baseline has no version\n' >&2
    exit 2
  }
  if [[ "$baseline_version" == "none" ]]; then
    current_version="$(logyard_release_version)"
    current_release="${current_version%-SNAPSHOT}"
    first_release="$(baseline_value first_release)"
    reason="$(baseline_value reason)"
    [[ -n "$first_release" && -n "$reason" ]] || {
      printf 'error: absent compatibility baseline requires first_release and reason\n' >&2
      exit 2
    }
    [[ "$current_release" == "$first_release" ]] || {
      printf 'error: absent compatibility baseline applies only to first release %s, not %s\n' \
        "$first_release" "$current_version" >&2
      exit 2
    }
    printf 'API compatibility baseline: none for first release %s (%s)\n' \
      "$first_release" "$reason"
    exit 0
  fi
  [[ "$baseline_version" != *-SNAPSHOT ]] || {
    printf 'error: compatibility baseline must identify an immutable release\n' >&2
    exit 2
  }
  baseline_jars=()
  for surface in api runtime jul spring quarkus; do
    baseline_jars+=("$(fetch_baseline_artifact "$surface")")
  done
  [[ "${#baseline_jars[@]}" -eq 5 ]] || {
    printf 'error: compatibility baseline resolved %d jars instead of 5\n' "${#baseline_jars[@]}" >&2
    exit 2
  }
  old_api="${baseline_jars[0]}"
  old_runtime="${baseline_jars[1]}"
  old_jul="${baseline_jars[2]}"
  old_spring="${baseline_jars[3]}"
  old_quarkus="${baseline_jars[4]}"
  mode="release $baseline_version baseline"
  build_current_jars
elif [[ "$#" -eq 1 && "$1" == "--self-test" ]]; then
  build_current_jars
  old_api="$CURRENT_DIR/logyard-api-current.jar"
  old_runtime="$CURRENT_DIR/logyard-runtime-current.jar"
  old_jul="$CURRENT_DIR/logyard-jul-current.jar"
  old_spring="$CURRENT_DIR/logyard-spring-boot-current.jar"
  old_quarkus="$CURRENT_DIR/logyard-quarkus-current.jar"
  mode="tool wiring self-test"
elif [[ "$#" -eq 5 ]]; then
  old_api="$1"
  old_runtime="$2"
  old_jul="$3"
  old_spring="$4"
  old_quarkus="$5"
  for old_jar in "$old_api" "$old_runtime" "$old_jul" "$old_spring" "$old_quarkus"; do
    require_file "$old_jar"
  done
  build_current_jars
  mode="caller-supplied baseline"
else
  usage >&2
  exit 2
fi

install_japicmp
compare "$old_api" "$CURRENT_DIR/logyard-api-current.jar" "com.zsumz.logyard.api.*"
compare "$old_runtime" "$CURRENT_DIR/logyard-runtime-current.jar" "com.zsumz.logyard.runtime.bootstrap.*"
compare "$old_runtime" "$CURRENT_DIR/logyard-runtime-current.jar" "com.zsumz.logyard.runtime.management.*"
compare "$old_jul" "$CURRENT_DIR/logyard-jul-current.jar" "com.zsumz.logyard.jul.*"
compare "$old_spring" "$CURRENT_DIR/logyard-spring-boot-current.jar" "com.zsumz.logyard.spring.boot.autoconfigure.*"
compare "$old_spring" "$CURRENT_DIR/logyard-spring-boot-current.jar" "com.zsumz.logyard.spring.boot.logging.*"
compare "$old_spring" "$CURRENT_DIR/logyard-spring-boot-current.jar" "com.zsumz.logyard.spring.boot.nativeimage.*"
compare "$old_quarkus" "$CURRENT_DIR/logyard-quarkus-current.jar" "com.zsumz.logyard.quarkus.runtime.*"
printf 'API compatibility %s passed for Logyard API, bootstrap, management, JUL, Spring Boot, and Quarkus surfaces.\n' "$mode"
