#!/usr/bin/env bash
set -euo pipefail

export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/logyard-release.sh"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"
JAPICMP_VERSION="0.26.1"
JAPICMP_SHA256="4b4f0301861d97cd2a05af3f7fa9173cc1dd3831b1284b2b9e2f81c4f1c2f858"
TOOL_DIR="$ROOT/target/tools"
JAPICMP_JAR="$TOOL_DIR/japicmp-$JAPICMP_VERSION.jar"
CURRENT_DIR="$ROOT/target/api-compatibility"
BASELINE_MANIFEST="$ROOT/compatibility-baseline.toml"
BASELINE_DIR="$CURRENT_DIR/baseline"
export PYTHONPATH="$ROOT/scripts"
api_records="$(python3 -m verify_tools.supported_api "$ROOT" records)"
internal_annotation="$(python3 -m verify_tools.supported_api "$ROOT" annotation)"
surfaces=() artifacts=() members=() includes=() canary_classes=() canary_members=()
while IFS=$'\t' read -r surface artifact member include canary_class canary_member; do
  surfaces+=("$surface")
  artifacts+=("$artifact")
  members+=("$member")
  includes+=("$include")
  canary_classes+=("$canary_class")
  canary_members+=("$canary_member")
done <<< "$api_records"

usage() {
  cat <<'USAGE'
Usage:
  scripts/api-compatibility --baseline
  scripts/api-compatibility OLD_JAR...
  scripts/api-compatibility --self-test

--baseline enforces compatibility against the checksummed release declared in
compatibility-baseline.toml, or confirms an explicit "none" policy before the
first public release. Supply one OLD_JAR per supported-api.toml surface in manifest
order. --self-test verifies identical artifacts, rejects a removed supported declaration
on every surface, and confirms that internal declarations remain excluded.
USAGE
}

digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

require_file() {
  [[ -f "$1" ]] || {
    printf 'error: required jar does not exist: %s\n' "$1" >&2
    exit 2
  }
}

baseline_value() {
  local key="$1"
  sed -n "/^\[artifacts\]/q; s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*$/\\1/p" \
    "$BASELINE_MANIFEST" | head -n 1
}

baseline_artifact_value() {
  local surface="$1"
  local field="$2"
  local line
  line="$(sed -n "/^[[:space:]]*$surface[[:space:]]*=/p" "$BASELINE_MANIFEST" | head -n 1)"
  [[ -n "$line" ]] || return
  printf '%s\n' "$line" | sed -n "s/.*$field[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
}

fetch_baseline_artifact() {
  local surface="$1"
  local expected_artifact="$2"
  local artifact checksum group repository source temporary destination actual
  artifact="$(baseline_artifact_value "$surface" artifact)"
  checksum="$(baseline_artifact_value "$surface" sha256)"
  [[ "$artifact" == "$expected_artifact" && "$checksum" =~ ^[0-9a-f]{64}$ ]] || {
    printf 'error: compatibility baseline artifact %s is incomplete\n' "$surface" >&2
    exit 2
  }
  group="$(baseline_value group)"
  group="${group:-com.logyard4j}"
  repository="$(baseline_value repository)"
  [[ -n "$repository" ]] || {
    printf 'error: compatibility baseline has no repository\n' >&2
    exit 2
  }
  source="${repository%/}/$(logyard_group_path "$group")/$artifact/$baseline_version/$artifact-$baseline_version.jar"
  destination="$BASELINE_DIR/$artifact-$baseline_version.jar"
  mkdir -p "$BASELINE_DIR"
  temporary="$(mktemp "$BASELINE_DIR/.${artifact}.XXXXXX")"
  if ! curl -fsSL "$source" -o "$temporary"; then
    rm -f "$temporary"
    printf 'error: unable to fetch compatibility baseline artifact: %s\n' "$source" >&2
    exit 2
  fi
  actual="$(digest "$temporary")"
  [[ "$actual" == "$checksum" ]] || {
    rm -f "$temporary"
    printf 'error: compatibility baseline checksum mismatch for %s\n' "$artifact" >&2
    exit 2
  }
  mv "$temporary" "$destination"
  printf '%s\n' "$destination"
}

install_japicmp() {
  mkdir -p "$TOOL_DIR"
  if [[ ! -f "$JAPICMP_JAR" ]]; then
    curl -fsSL \
      -o "$JAPICMP_JAR" \
      "https://repo.maven.apache.org/maven2/com/github/siom79/japicmp/japicmp/$JAPICMP_VERSION/japicmp-$JAPICMP_VERSION-jar-with-dependencies.jar"
  fi
  local actual
  actual="$(digest "$JAPICMP_JAR")"
  [[ "$actual" == "$JAPICMP_SHA256" ]] || {
    printf 'error: japicmp checksum mismatch: expected %s, found %s\n' "$JAPICMP_SHA256" "$actual" >&2
    exit 2
  }
}

build_current_jars() {
  "$ROOT/scripts/package"
  mkdir -p "$CURRENT_DIR"
  local version index source
  version="$(logyard_release_version)"
  for index in "${!surfaces[@]}"; do
    source="$ROOT/${members[index]}/target/${artifacts[index]}-$version.jar"
    require_file "$source"
    cp "$source" "$CURRENT_DIR/${artifacts[index]}-current.jar"
  done
}

compare() {
  local old_jar="$1"
  local new_jar="$2"
  local include="$3"
  java -jar "$JAPICMP_JAR" \
    --old "$old_jar" \
    --new "$new_jar" \
    --include "$include" \
    --include-exclusively \
    --exclude "@$internal_annotation" \
    --only-modified \
    --ignore-missing-classes \
    --error-on-binary-incompatibility \
    --error-on-source-incompatibility
}

mode=""
if [[ "$#" -eq 1 && "$1" == "--baseline" ]]; then
  [[ "$(sed -n 's/^[[:space:]]*schema[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$BASELINE_MANIFEST" | head -n 1)" == 1 ]] || {
    printf 'error: compatibility baseline schema must be 1\n' >&2
    exit 2
  }
  baseline_version="$(baseline_value version)"
  [[ -n "$baseline_version" ]] || {
    printf 'error: compatibility baseline has no version\n' >&2
    exit 2
  }
  if [[ "$baseline_version" == "none" ]]; then
    current_version="$(logyard_release_version)"
    current_release="${current_version%-SNAPSHOT}"
    first_release="$(baseline_value first_release)"
    reason="$(baseline_value reason)"
    [[ -n "$first_release" && -n "$reason" ]] || {
      printf 'error: absent compatibility baseline requires first_release and reason\n' >&2
      exit 2
    }
    [[ "$current_release" == "$first_release" ]] || {
      printf 'error: absent compatibility baseline applies only to first release %s, not %s\n' \
        "$first_release" "$current_version" >&2
      exit 2
    }
    printf 'API compatibility baseline: none for first release %s (%s)\n' \
      "$first_release" "$reason"
    exit 0
  fi
  [[ "$baseline_version" != *-SNAPSHOT ]] || {
    printf 'error: compatibility baseline must identify an immutable release\n' >&2
    exit 2
  }
  old_jars=()
  for index in "${!surfaces[@]}"; do
    old_jars+=("$(fetch_baseline_artifact "${surfaces[index]}" "${artifacts[index]}")")
  done
  mode="release $baseline_version baseline"
  build_current_jars
elif [[ "$#" -eq 1 && "$1" == "--self-test" ]]; then
  build_current_jars
  old_jars=()
  for artifact in "${artifacts[@]}"; do
    old_jars+=("$CURRENT_DIR/$artifact-current.jar")
  done
  mode="tool wiring and breaking-change self-test"
elif [[ "$#" -eq "${#surfaces[@]}" ]]; then
  old_jars=("$@")
  for old_jar in "${old_jars[@]}"; do
    require_file "$old_jar"
  done
  build_current_jars
  mode="caller-supplied baseline"
else
  usage >&2
  exit 2
fi

install_japicmp
for index in "${!surfaces[@]}"; do
  current="$CURRENT_DIR/${artifacts[index]}-current.jar"
  compare "${old_jars[index]}" "$current" "${includes[index]}"
  if [[ "$mode" == "tool wiring and breaking-change self-test" ]]; then
    broken="$CURRENT_DIR/${artifacts[index]}-breaking.jar"
    report="$CURRENT_DIR/${artifacts[index]}-breaking.txt"
    java --class-path "$JAPICMP_JAR" "$ROOT/scripts/compatibility/RemoveApiMember.java" \
      "$current" "$broken" "${canary_classes[index]}" "${canary_members[index]}"
    if compare "$current" "$broken" "${includes[index]}" > "$report" 2>&1; then
      printf 'error: compatibility gate accepted removal of %s#%s\n' \
        "${canary_classes[index]}" "${canary_members[index]}" >&2
      exit 1
    fi
    if ! grep -Eq 'REMOVED (METHOD|CONSTRUCTOR)' "$report"; then
      cat "$report" >&2
      printf 'error: compatibility canary failed without detecting the removed declaration\n' >&2
      exit 1
    fi
    printf 'Breaking-API canary rejected for %s.\n' "${surfaces[index]}"
  fi
done

if [[ "$mode" == "tool wiring and breaking-change self-test" ]]; then
  current="$CURRENT_DIR/logyard-api-current.jar"
  internal="$CURRENT_DIR/logyard-api-internal-change.jar"
  java --class-path "$JAPICMP_JAR" "$ROOT/scripts/compatibility/RemoveApiMember.java" \
    "$current" "$internal" com.logyard4j.logyard.api.Logyard initializeManaged
  compare "$current" "$internal" com.logyard4j.logyard.api
  printf 'Internal-method exclusion canary passed.\n'
fi
printf 'API compatibility %s passed for %d supported artifact surfaces.\n' "$mode" "${#surfaces[@]}"
