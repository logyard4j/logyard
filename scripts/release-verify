#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${LOGYARD_RELEASE_TARGET:-$ROOT/target/release-bundle}"
REQUIRE_SIGNATURES=false

usage() {
  printf 'usage: %s [--require-signatures]\n' "$0" >&2
  exit 2
}

if [[ $# -gt 1 ]]; then
  usage
fi
if [[ $# -eq 1 ]]; then
  [[ "$1" == "--require-signatures" ]] || usage
  REQUIRE_SIGNATURES=true
fi

arguments=("$ROOT" "$TARGET")
if "$REQUIRE_SIGNATURES"; then
  arguments+=(--require-signatures)
fi
PYTHONPATH="$ROOT/scripts" python3 -m release_tools.verify "${arguments[@]}"

if "$REQUIRE_SIGNATURES" || find "$TARGET" -type f -name '*.asc' -print -quit | grep -q .; then
  GPG="${GPG:-gpg}"
  while IFS= read -r signature; do
    "$GPG" --batch --verify "$signature" "${signature%.asc}"
  done < <(find "$TARGET" -type f -name '*.asc' -print | LC_ALL=C sort)
fi
