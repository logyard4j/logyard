#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${LOGYARD_PACKAGE_VERIFY_TARGET:-$ROOT/target/package-verify}"
JAVAC="${JAVAC:-javac}"
JAVA="${JAVA:-java}"
JAR="${JAR:-jar}"

members=()
module_names=()
artifact_counts=()
VERSION=
while IFS=$'\t' read -r member module_name version artifact_count; do
  members+=("$member")
  module_names+=("$module_name")
  artifact_counts+=("$artifact_count")
  if [[ -z "$VERSION" ]]; then
    VERSION="$version"
  elif [[ "$VERSION" != "$version" ]]; then
    printf 'package verification failed: publication versions do not match\n' >&2
    exit 1
  fi
done < <(PYTHONPATH="$ROOT/scripts" python3 -m release_tools.manifest_cli jar-records "$ROOT")
[[ ${#members[@]} -gt 0 ]] || {
  printf 'package verification failed: no publishable JAR modules were discovered\n' >&2
  exit 1
}

fail() {
  printf 'package verification failed: %s\n' "$1" >&2
  exit 1
}

require_entry() {
  local archive="$1"
  local entry="$2"
  "$JAR" tf "$archive" | grep -Fxq "$entry" || fail "$(basename "$archive") is missing $entry"
}

find_dependency() {
  local filename="$1"
  local candidate search_root
  for candidate in "$ROOT/.zolt/cache/$filename" "$HOME/.zolt/cache/$filename"; do
    [[ -f "$candidate" ]] && {
      printf '%s\n' "$candidate"
      return
    }
  done
  for search_root in "$ROOT/.zolt" "$HOME/.zolt"; do
    [[ -d "$search_root" ]] || continue
    candidate="$(find "$search_root" -type f -name "$filename" -print -quit 2>/dev/null || true)"
    [[ -z "$candidate" ]] || {
      printf '%s\n' "$candidate"
      return
    }
  done
}

case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) classpath_separator=';' ;;
  *) classpath_separator=':' ;;
esac

main_jars=()
release_artifact_count=0
for index in "${!members[@]}"; do
  member="${members[$index]}"
  module_name="${module_names[$index]}"
  release_artifact_count=$((release_artifact_count + artifact_counts[index]))
  target="$ROOT/modules/$member/target"
  main="$target/$member-$VERSION.jar"
  sources="$target/$member-$VERSION-sources.jar"
  javadoc="$target/$member-$VERSION-javadoc.jar"
  for artifact in "$main" "$sources" "$javadoc"; do
    [[ -s "$artifact" ]] || fail "missing or empty artifact: $artifact"
  done
  module_description="$("$JAR" --describe-module --file "$main")"
  printf '%s\n' "$module_description" | grep -Eq "^${module_name}@${VERSION} automatic$" \
    || fail "$member does not expose automatic module name $module_name"
  "$JAR" tf "$main" | grep -qE '\.class$' || fail "$member main jar has no classes"
  "$JAR" tf "$sources" | grep -qE '\.java$' || fail "$member sources jar has no Java sources"
  require_entry "$javadoc" "index.html"
  if "$JAR" tf "$main" | grep -qE '(^|/)test(s)?/|Test\\.class$'; then
    fail "$member main jar contains test classes"
  fi
  main_jars+=("$main")
done

maven_module_count=0
while IFS=$'\t' read -r module_path member module_name version artifact_count; do
  [[ -n "$module_path" ]] || continue
  [[ "$VERSION" == "$version" ]] || fail "Maven publication versions do not match"
  maven_module_count=$((maven_module_count + 1))
  release_artifact_count=$((release_artifact_count + artifact_count))
  target="$ROOT/$module_path/target"
  main="$target/$member-$VERSION.jar"
  sources="$target/$member-$VERSION-sources.jar"
  javadoc="$target/$member-$VERSION-javadoc.jar"
  for artifact in "$main" "$sources" "$javadoc"; do
    [[ -s "$artifact" ]] || fail "missing or empty Maven artifact: $artifact"
  done
  module_description="$("$JAR" --describe-module --file "$main")"
  printf '%s\n' "$module_description" | grep -Eq "^${module_name}@${VERSION} automatic$" \
    || fail "$member does not expose automatic module name $module_name"
  "$JAR" tf "$main" | grep -qE '\.class$' || fail "$member main jar has no classes"
  "$JAR" tf "$sources" | grep -qE '\.java$' || fail "$member sources jar has no Java sources"
  require_entry "$javadoc" "index.html"
  if "$JAR" tf "$main" | grep -qE '(^|/)test(s)?/|Test\\.class$'; then
    fail "$member main jar contains test classes"
  fi
done < <(PYTHONPATH="$ROOT/scripts" python3 -m release_tools.manifest_cli maven-records "$ROOT")

[[ "$maven_module_count" -gt 0 ]] || fail "no Maven-built extension publications were discovered"
quarkus_runtime="$ROOT/extensions/logyard-quarkus/runtime/target/logyard-quarkus-$VERSION.jar"
require_entry "$quarkus_runtime" "META-INF/quarkus-extension.yaml"
require_entry "$quarkus_runtime" "META-INF/quarkus-extension.properties"
descriptor_target="$TARGET/quarkus-descriptor"
rm -rf "$descriptor_target"
mkdir -p "$descriptor_target"
(
  cd "$descriptor_target"
  "$JAR" xf "$quarkus_runtime" META-INF/quarkus-extension.properties
)
deployment_coordinate="$(sed -n 's/^deployment-artifact=//p' \
  "$descriptor_target/META-INF/quarkus-extension.properties" | tr -d '\\')"
[[ "$deployment_coordinate" == "com.zsumz.logyard:logyard-quarkus-deployment:$VERSION" ]] \
  || fail "Quarkus descriptor names unexpected deployment artifact: $deployment_coordinate"

require_entry "$ROOT/modules/logyard-slf4j2/target/logyard-slf4j2-$VERSION.jar" \
  "META-INF/services/org.slf4j.spi.SLF4JServiceProvider"
require_entry "$ROOT/modules/logyard-system-logger/target/logyard-system-logger-$VERSION.jar" \
  'META-INF/services/java.lang.System$LoggerFinder'

slf4j_api="$(find_dependency 'slf4j-api-2.0.18.jar')"
[[ -n "$slf4j_api" ]] || fail "slf4j-api-2.0.18.jar is not available in the Zolt cache"

packaged_classpath=""
for archive in "${main_jars[@]}" "$slf4j_api"; do
  if [[ -z "$packaged_classpath" ]]; then
    packaged_classpath="$archive"
  else
    packaged_classpath="$packaged_classpath$classpath_separator$archive"
  fi
done

rm -rf "$TARGET"
mkdir -p "$TARGET/extensions" "$TARGET/facades"

extension_sources=()
while IFS= read -r source; do
  extension_sources+=("$source")
done < <(find "$ROOT/tests/logyard-integration-tests/src/main/java" -type f -name '*.java' -print | LC_ALL=C sort)
"$JAVAC" --release 21 -encoding UTF-8 -Xlint:all -Werror \
  -cp "$packaged_classpath" \
  -d "$TARGET/extensions" \
  "${extension_sources[@]}"
cp -R "$ROOT/tests/logyard-integration-tests/src/main/resources/." "$TARGET/extensions/"
"$JAVA" -cp "$packaged_classpath$classpath_separator$TARGET/extensions" \
  com.zsumz.logyard.tests.CoreVerificationMain

cat > "$TARGET/PackagedFacadeCanary.java" <<'JAVA'
import com.zsumz.logyard.runtime.bootstrap.LogyardBootstrap;
import com.zsumz.logyard.runtime.bootstrap.RuntimeBundle;
import org.slf4j.LoggerFactory;
import org.slf4j.spi.SLF4JServiceProvider;

import java.lang.System.LoggerFinder;
import java.nio.file.Path;
import java.util.ServiceLoader;

public final class PackagedFacadeCanary {
    public static void main(String[] arguments) {
        if (arguments.length != 1) {
            throw new IllegalArgumentException("expected configuration path");
        }
        long slf4jProviders = ServiceLoader.load(SLF4JServiceProvider.class).stream().count();
        long systemProviders = ServiceLoader.load(LoggerFinder.class).stream().count();
        if (slf4jProviders != 1 || systemProviders != 1) {
            throw new AssertionError("unexpected providers: slf4j=" + slf4jProviders + ", system=" + systemProviders);
        }
        try (RuntimeBundle bundle = LogyardBootstrap.start(Path.of(arguments[0]))) {
            bundle.runtime().logger("packaged.native").info("native packaged canary");
            LoggerFactory.getLogger("packaged.slf4j").info("slf4j packaged canary");
            System.getLogger("packaged.system").log(System.Logger.Level.INFO, "system packaged canary");
            bundle.runtime().flush();
        }
    }
}
JAVA

output="$TARGET/events.jsonl"
escaped_output="${output//\\/\\\\}"
cat > "$TARGET/logyard.toml" <<TOML
schema = 1
[runtime]
watch = false
internal_status = "off"
[delivery]
mode = "sync"
capacity = 16
[loggers]
root = { level = "info", outputs = ["json"] }
[outputs.json]
type = "file"
path = "$escaped_output"
append = true
buffer = "4KiB"
flush = "0s"
TOML

"$JAVAC" --release 21 -encoding UTF-8 -Xlint:all -Werror \
  -cp "$packaged_classpath" \
  -d "$TARGET/facades" \
  "$TARGET/PackagedFacadeCanary.java"
"$JAVA" -cp "$packaged_classpath$classpath_separator$TARGET/facades" \
  PackagedFacadeCanary "$TARGET/logyard.toml"

for message in "native packaged canary" "slf4j packaged canary" "system packaged canary"; do
  grep -Fq "$message" "$output" || fail "packaged façade output is missing: $message"
done

printf 'Packaged-JAR verification passed: %d release artifacts, %d module names, extension SPIs, SLF4J, and System.Logger.\n' \
  "$release_artifact_count" "$(( ${#members[@]} + maven_module_count ))"
