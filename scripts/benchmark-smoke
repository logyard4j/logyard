#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/logyard-release.sh"
ZOLT="$(logyard_require_zolt)"
TARGET="$ROOT/target/benchmark-smoke"
MAVEN_REPOSITORY="$TARGET/maven-repository"
CORE_RESULTS="$TARGET/core.json"
QUARKUS_RESULTS="$TARGET/quarkus.json"
MANAGEMENT_RESULTS="$TARGET/management.json"
export LOGYARD_BENCHMARK_EVIDENCE="$TARGET/delivery.jsonl"
export LOGYARD_BENCHMARK_DIRECTORY="${LOGYARD_BENCHMARK_DIRECTORY:-$ROOT/target/benchmark-files}"

cd "$ROOT"
mkdir -p "$TARGET"
rm -f "$LOGYARD_BENCHMARK_EVIDENCE"
if [[ "${LOGYARD_BENCHMARK_SKIP_RELEASE:-0}" != "1" ]]; then
  "$ROOT/scripts/release-bundle"
fi
"$ROOT/scripts/release-verify"
"$ZOLT" run --directory "$ROOT" --workspace --member benchmarks/logyard-benchmarks -- \
  '.*(AdapterGuardBenchmark|AsyncDeliveryBenchmark\.oneProducer|CapturedEventAllocationBenchmark|CompositeSinkBenchmark\.success|ConcurrentJsonEncoderBenchmark\.encodeOnSharedInstance|ContextPolicyBenchmark|EncodingBenchmark\.(jsonEncoding|literalMessage|messageFormatChoice|messageFormatDate|messageFormatNumber|messageFormatOneString|messageFormatTwoStrings|nestedRedactionWithoutMatch|printfDate|printfNumber|printfString|redactionWithoutMatch|rejectedDefaultNumberExpansion|rejectedRecursiveChoiceExpansion)|JsonSinkBenchmark|OverflowPolicyBenchmark|SynchronousOverflowBenchmark|NativeIngressBenchmark\.(disabled|enabledOneArgument|twoOutputFanout)|Slf4jIngressBenchmark\.(disabled|enabledEmptyMdc)|Slf4jProviderBenchmark\.(disabled|enabledOneProducer|enabledFourProducers|enabledSixteenProducers|enabledPopulatedMdc)|Slf4jProviderFirstCallBenchmark\.firstCall|Slf4jProviderRecoveryBenchmark\.recoverAfterManagedShutdown|TimedFlushBenchmark\.recordWhileFlushPending|TimedFlushDispatchBenchmark\.dispatchAndComplete).*' \
  -foe true -wi 3 -i 3 -f 1 -w 1s -r 500ms -prof gc -rf json -rff "$CORE_RESULTS"

PYTHONPATH="$ROOT/scripts" python3 -m benchmark_tools.delivery "$CORE_RESULTS" "$LOGYARD_BENCHMARK_EVIDENCE"

"$ZOLT" run --directory "$ROOT" --workspace --member benchmarks/logyard-benchmarks -- \
  '.*LoggerManagementBenchmark.*' -foe true -wi 5 -i 5 -w 1s -r 1s -f 1 -prof gc -rf json -rff "$MANAGEMENT_RESULTS"

rm -rf "$MAVEN_REPOSITORY"
# Resolve the extension under test from the verified release bundle.
mvn --batch-mode --no-transfer-progress \
  -Dmaven.repo.local="$MAVEN_REPOSITORY" \
  -Dlogyard.repository="file://$ROOT/target/release-bundle" \
  -DskipTests \
  -f extensions/logyard-quarkus/pom.xml \
  -Pbenchmarks \
  -pl benchmarks \
  package

version="$(logyard_release_version)"
quarkus_artifact="com/zsumz/logyard/logyard-quarkus/$version/logyard-quarkus-$version.jar"
cmp "$MAVEN_REPOSITORY/$quarkus_artifact" "$ROOT/target/release-bundle/$quarkus_artifact"
"$ROOT/scripts/release-verify"

java -jar extensions/logyard-quarkus/benchmarks/target/logyard-quarkus-benchmarks.jar \
  '.*QuarkusEventMappingBenchmark\.(mapFreshRecord|mapCopiedRecord).*' \
  -foe true -wi 3 -i 3 -f 1 -w 1s -r 500ms -prof gc -rf json -rff "$QUARKUS_RESULTS"

PYTHONPATH="$ROOT/scripts" python3 -m benchmark_tools.allocations \
  benchmarks/allocation-budgets.json \
  "$CORE_RESULTS" \
  "$MANAGEMENT_RESULTS" \
  "$QUARKUS_RESULTS"
