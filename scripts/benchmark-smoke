#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"
TARGET="$ROOT/target/benchmark-smoke"
MAVEN_REPOSITORY="$TARGET/maven-repository"
CORE_RESULTS="$TARGET/core.json"
QUARKUS_RESULTS="$TARGET/quarkus.json"

cd "$ROOT"
mkdir -p "$TARGET"
if [[ "${LOGYARD_BENCHMARK_SKIP_RELEASE:-0}" != "1" ]]; then
  "$ROOT/scripts/release-bundle"
fi
"$ROOT/scripts/release-verify"
"$ZOLT" run --directory "$ROOT" --workspace --member benchmarks/logyard-benchmarks -- \
  '.*(AsyncDeliveryBenchmark\.oneProducer|CapturedEventAllocationBenchmark|CompositeSinkBenchmark\.success|ConcurrentJsonEncoderBenchmark\.encodeOnSharedInstance|ContextPolicyBenchmark|EncodingBenchmark\.(jsonEncoding|literalMessage|messageFormatChoice|messageFormatDate|messageFormatNumber|messageFormatOneString|messageFormatTwoStrings|nestedRedactionWithoutMatch|printfDate|printfNumber|printfString|redactionWithoutMatch|rejectedDefaultNumberExpansion|rejectedRecursiveChoiceExpansion)|JsonSinkBenchmark\.(directFile|directStream|synchronousRuntimeJson)|LoggerManagementBenchmark\.(listAllLevels|pointLevel)|NativeIngressBenchmark\.(disabled|enabledOneArgument|twoOutputFanout)|Slf4jIngressBenchmark\.enabledEmptyMdc|Slf4jProviderBenchmark\.(disabled|enabledOneProducer|enabledFourProducers|enabledSixteenProducers|enabledPopulatedMdc)|Slf4jProviderFirstCallBenchmark\.firstCall|Slf4jProviderRecoveryBenchmark\.recoverAfterManagedShutdown|TimedFlushBenchmark\.recordWhileFlushPending|TimedFlushDispatchBenchmark\.dispatchAndComplete).*' \
  -wi 1 -i 2 -f 1 -w 200ms -r 200ms -prof gc -rf json -rff "$CORE_RESULTS"

rm -rf "$MAVEN_REPOSITORY"
mvn --batch-mode --no-transfer-progress \
  -Dmaven.repo.local="$MAVEN_REPOSITORY" \
  -Dlogyard.repository="file://$ROOT/target/release-bundle" \
  -DskipTests \
  -f extensions/logyard-quarkus/pom.xml \
  -Pbenchmarks \
  -pl benchmarks \
  -am \
  package

java -jar extensions/logyard-quarkus/benchmarks/target/logyard-quarkus-benchmarks.jar \
  '.*QuarkusEventMappingBenchmark\.(mapFreshRecord|mapCopiedRecord).*' \
  -wi 2 -i 3 -f 1 -w 500ms -r 500ms -prof gc -rf json -rff "$QUARKUS_RESULTS"

PYTHONPATH="$ROOT/scripts" python3 -m benchmark_tools.allocations \
  benchmarks/allocation-budgets.json \
  "$CORE_RESULTS" \
  "$QUARKUS_RESULTS"
