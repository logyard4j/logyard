#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOLT="${ZOLT:-$HOME/.zolt/bin/zolt}"
cd "$ROOT"

./scripts/repository-check
./scripts/verify
./scripts/javadoc

if [[ -x "$ZOLT" ]]; then
  if [[ -f zolt.lock ]]; then
    "$ZOLT" resolve --workspace --locked
  else
    "$ZOLT" resolve --workspace
  fi
  "$ZOLT" build --workspace --all
  "$ZOLT" test --workspace --all
  "$ZOLT" run --workspace --member tests/logyard-integration-tests
else
  echo "NOTE: Zolt is not installed at $ZOLT; the JDK-only verification completed successfully."
fi
